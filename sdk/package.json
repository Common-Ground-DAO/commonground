{
  "name": "@commonground/sdk-root",
  "private": true,
  "workspaces": [
    "client",
    "conformance"
  ],
  "scripts": {
    "build": "yarn workspace @commonground/client build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspace @commonground/conformance test",
    "openapi": "./tools/generate-openapi.sh",
    "openapi:check": "./tools/generate-openapi.sh --check",
    "instance:up": "./conformance/tools/disposable-instance.sh up",
    "instance:down": "./conformance/tools/disposable-instance.sh down"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
