# Common Ground dev stack configuration — TEMPLATE.
#
# docker/.env (gitignored) is the file the dev stack actually reads: run.sh,
# the scripts in docker/ and tools/ source it, and docker compose reads it for
# the ${VAR} references in docker-compose.yml. If it is missing, the first
# ./run.sh call creates it from this template (docker/ensureEnv.sh) with fresh
# random values for every secret and BUILDER_UID/GID set to your user.
#
# Never commit docker/.env. When you add a variable here, existing checkouts
# do not get it automatically — ./run.sh warns about variables this template
# has and the local docker/.env lacks, so copy the new lines over by hand.
#
# Third-party keys use the placeholder "your-key" (or stay empty): the
# corresponding feature is unavailable until you put a real value into your
# local docker/.env.

### Secrets — generated on first run
# Every "generated-on-first-run" value is replaced with `openssl rand -hex`
# output when docker/.env is created. Change them only on a fresh stack:
# postgres applies the four PG_* passwords only when the pgdata volume is first
# initialized (docker/db/init.sh).
#   PG_SU_PASSWORD         postgres superuser (db; migrate-db and cg-builder log in with it)
#   PG_WRITER_PASSWORD     `writer` role, used by api, wsapi, memberlist, job-runner, onchain
#   PG_READER_PASSWORD     `reader` role (created by docker/db/init.sh; no dev service uses it)
#   PG_MEDIASOUP_PASSWORD  `mediasoup` role, used by mediasoup (created by docker/db/init.sh;
#                          migration addMediasoupRole creates it only if missing)
#   REDIS_PASSWORD         redis --requirepass, used by every backend service
#   REDIS_SECRET           signs the session cookies (api and wsapi must agree)
#   S3_SECRET              SeaweedFS S3 secret key of access key `cgadmin`; the
#                          matching docker/s3_config/s3.json is generated from it
#   PGADMIN_SECRET         pgAdmin login (the pgadmin service is commented out)
PG_SU_PASSWORD=generated-on-first-run
PG_WRITER_PASSWORD=generated-on-first-run
PG_READER_PASSWORD=generated-on-first-run
PG_MEDIASOUP_PASSWORD=generated-on-first-run
REDIS_PASSWORD=generated-on-first-run
REDIS_SECRET=generated-on-first-run
S3_SECRET=generated-on-first-run
PGADMIN_SECRET=generated-on-first-run
PGADMIN_EMAIL=pgadmin@admin.com

### Deployment
# DEPLOYMENT drives feature flags, the default chain set and the session
# cookie name (dev | staging | prod; keep "dev" for this stack).
# BASE_URL is the URL the app is served at (nginx publishes port 8000).
DEPLOYMENT=dev
BASE_URL=http://localhost:8000

# uid/gid the cg-builder container runs as, so files it writes into the
# checkout keep your ownership. Set to `id -u` / `id -g` on first run.
BUILDER_UID=1000
BUILDER_GID=1000

# true = the onchain service recomputes all token balances and role
# assignments once at startup
RECALCULATE_BALANCES_AND_ROLES=false

### Calls (mediasoup) and network binding
# true = mediasoup's workers run without io_uring (libuv UV_USE_IO_URING=0).
# The safe default: some kernels/container runtimes make mediasoup fail with
# an io_uring error. Set false to let libuv use io_uring where it works.
MEDIASOUP_DISABLE_LIBURING=true

### Choose one of the two setups.
# With localhost access only, you can have mediasoup calls on localhost, but only with "./run.sh start_https"
# With Local Area Network access, you can have mediasoup calls on all devices in your LAN, but you
# also need to use "./run.sh start_https" and access cg via https://<LAN_IP>:3000/. If you use localhost here,
# calls will fail (even on the local machine itself!)

### localhost access only
LOCAL_CERTIFICATE_IP=
MEDIASOUP_ANNOUNCED_IP=localhost
EXTERNAL_LISTEN_IP=127.0.0.1

### Local Area Network access
# LOCAL_CERTIFICATE_IP=192.168.0.100
# MEDIASOUP_ANNOUNCED_IP=192.168.0.100
# EXTERNAL_LISTEN_IP=0.0.0.0
#   (this also exposes the mailpit UI on port 8025, which has no login and
#   shows every caught mail — login codes included — to anyone on the LAN)

### Captcha (registration spam protection; docs/auth-identity §6)
# CAPTCHA_PROVIDER: altcha | recaptcha | off. Empty = auto: recaptcha when
# GOOGLE_RECAPTCHA_SECRET_KEY is non-empty, otherwise ALTCHA (self-hosted
# proof-of-work, needs no third-party key). Any non-empty reCAPTCHA secret
# counts — a placeholder like "your-key" would select reCAPTCHA and make every
# signup fail, so leave it empty unless you have a real key.
# ALTCHA_HMAC_KEY signs the ALTCHA challenges (generated on first run). Empty
# is fine too: the backend then generates a key and shares it via Redis.
CAPTCHA_PROVIDER=
ALTCHA_HMAC_KEY=generated-on-first-run
GOOGLE_RECAPTCHA_SECRET_KEY=

### Email (SMTP; docs/email-notifications)
# The dev stack sends every mail to its mailpit catcher — nothing leaves the
# machine; read them at http://localhost:8025 (EXTERNAL_LISTEN_IP:8025).
# Empty SMTP_HOST disables email (login codes, verification, notifications).
#   SMTP_SECURITY  tls (implicit TLS, port 465) | starttls (required, 587) |
#                  none (no TLS — internal relays/catchers only)
#   SMTP_PORT      empty = 465 / 587 / 25 by SMTP_SECURITY
#   SMTP_USER/SMTP_PASSWORD  both or neither
#   EMAIL_FROM     sender address (empty = no-reply@<host of BASE_URL>)
#   EMAIL_FROM_NAME display name (empty = Common Ground)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

### Twitter/X OAuth 2
TWITTER_CALLBACK_URL=https://localhost:3000/twitter-callback
TWITTER_OAUTH2_CLIENT_ID=your-key
TWITTER_OAUTH2_CLIENT_SECRET=your-key

### Blockchain RPC endpoints (onchain service)
# JSON-RPC endpoint URLs per chain; the QUIKNODE_* names are historical, any
# provider works. The dev stack's own chain is the local hardhat node, which
# needs none of these. QUIKNODE_LUKSO falls back to the public LUKSO RPC when
# empty.
QUIKNODE_ETH=your-key
QUIKNODE_BSC=your-key
QUIKNODE_MATIC=your-key
QUIKNODE_XDAI=your-key
QUIKNODE_FANTOM=your-key
QUIKNODE_AVAX=your-key
QUIKNODE_ARBITRUM=your-key
QUIKNODE_OPTIMISM=your-key
QUIKNODE_BASE=your-key

INFURA_LINEA=your-key
QUIKNODE_ARBITRUM_NOVA=your-key
QUIKNODE_CELO=your-key
QUIKNODE_POLYGON_ZKEVM=your-key
QUIKNODE_SCROLL=your-key
QUIKNODE_ZKSYNC=your-key
QUIKNODE_LUKSO=

### Token staking (docs/staking/README.md)
# Off unless STAKING_CHAIN, STAKING_TOKEN_ADDRESS and STAKING_CONTRACT_ADDRESS
# are all set (addresses: 0x + 40 hex chars). STAKING_BASE_RATE is Spark per
# token per 365 days. Keep the three numbers set: an empty value is passed as
# an empty string, which the backend rejects as an invalid staking config.
STAKING_CHAIN=
STAKING_TOKEN_ADDRESS=
STAKING_CONTRACT_ADDRESS=
STAKING_BASE_RATE=0.012
STAKING_MIN_LOCK_DAYS=7
STAKING_MAX_LOCK_DAYS=730

### Bot accounts (docs/BOT-API.md)
# PLATFORM_OPERATOR_USER_IDS: comma-separated user UUIDs allowed to manage
# platform bots (empty = nobody). The limits count per active owner / token;
# invalid or non-positive values fall back to the defaults shown.
PLATFORM_OPERATOR_USER_IDS=
BOT_USER_OWNER_LIMIT=5
BOT_COMMUNITY_OWNER_LIMIT=10
BOT_PLATFORM_OWNER_LIMIT=10
BOT_ACTIVE_TOKEN_LIMIT=10
BOT_API_RATE_LIMIT_PER_MINUTE=120
BOT_MESSAGE_RATE_LIMIT_PER_MINUTE=30

### Server-side NSFW image filter
# In-process classifier, model baked into the backend image. Empty values
# fall back to the defaults.
#   IMAGE_MODERATION_ENABLED     true|false (default true; also gates the client-side warning)
#   IMAGE_MODERATION_THRESHOLD   nsfw score above which an upload is rejected (default 0.8)
#   IMAGE_MODERATION_MODEL_PATH  Transformers.js-layout classifier dir (default /models/nsfw)
IMAGE_MODERATION_ENABLED=true
IMAGE_MODERATION_THRESHOLD=
IMAGE_MODERATION_MODEL_PATH=

### Not passed into the dev containers
# The backend reads these, but docker-compose.yml does not hand them to any
# service, so in the dev stack they have no effect (the self-host compose
# file does pass them).
TWITTER_API_KEY=your-key
TWITTER_API_SECRET=your-key
